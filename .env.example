# Copy this file to .env (for local dev with `vercel dev`) or set these as
# environment variables in your hosting provider's dashboard.

# From a GitHub OAuth App you create at
# https://github.com/settings/developers -> "New OAuth App".
# Homepage URL: your deployed URL (e.g. https://handoff-webmcp.vercel.app)
# Authorization callback URL: <your deployed URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string. Used to encrypt the session cookie that holds
# the GitHub token — generate one with: openssl rand -hex 32
SESSION_SECRET=

# The exact URL this app is deployed at, no trailing slash.
# e.g. https://handoff-webmcp.vercel.app or http://localhost:3000
APP_URL=
